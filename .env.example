# Echo 环境变量示例 —— 复制为 .env 后填入自己的凭证
# 不填也能启动：未配置的平台在"账号"页会提示去申请（见 docs/API_APPLY_GUIDE.md）

# 服务端口与对外地址（OAuth 回调需要与平台登记的一致）
# 注意：X 控制台拒绝 localhost，必须用 127.0.0.1 或自定义本地域名
PORT=8787
APP_BASE_URL=http://127.0.0.1:8787

# X (Twitter) —— developer.x.com 创建 App 后获得
# 需要 User authentication settings: Read and write
#   + Callback: http://127.0.0.1:8787/auth/x/callback（不能用 localhost！）
X_CLIENT_ID=
X_CLIENT_SECRET=

# Threads —— developers.facebook.com 创建 App（用例：Threads API）后获得
# 需要 Redirect URI: http://127.0.0.1:8787/auth/threads/callback
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# Threads 发图要求图片 URL 公网可达（本机服务地址不可达）。
# 用隧道拿到公网地址后填这里，例如：
# THREADS_IMAGE_BASE_URL=https://your-tunnel.trycloudflare.com

# 数据目录（默认 ./data）
# ECHO_DATA_DIR=./data
